    "id": "306565",
    "type": "tmdb",
    "title": "DARK MACHINE THE ANIMATION",
    "posterPath": "https://image.tmdb.org/t/p/w500/hNNba8tLjCgRGcTSKcB1E0kpBhG.jpg",
